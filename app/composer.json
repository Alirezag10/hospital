{
    "name": "hospital/simple-project",
    "description": "Simple patient admission, services and discharge project",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "2.0.55",
        "yiisoft/yii2-bootstrap5": "2.0.51"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        }
    },
    "autoload": {
        "psr-4": {
            "app\\": "./"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
